# alpha-web 专用凭据文件：只放 web 进程真正用得到的。
# 复制成 .env.web 并 chmod 600。告警管线的凭据留在 .env 里，不要放这里 ——
# web 是唯一暴露在公网的进程，它被攻破时不该连带交出 Telegram bot token。

# 行情与社交数据都走 xAPI 网关
XAPI_KEY=

# 前端展示用
PUBLIC_SITE=https://example.com

# schema 要求 ERWA_API_TOKEN 非空，但 web 从不调用二娃，占位即可
ERWA_API_TOKEN=unused-by-web

# TG_BOT_TOKEN 与 TG_CHAT_ID 两个都不要填（schema 要求同时有或同时无）。
# 都为空 = web 进程根本没有能力往告警群发消息。
