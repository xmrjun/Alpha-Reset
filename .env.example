# 二娃聚合群 API（机密，勿提交）
ERWA_API_BASE=https://juhequn.com
ERWA_API_TOKEN=tok_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram 推送（待填）
TG_BOT_TOKEN=
TG_CHAT_ID=

# 前端
PUBLIC_SITE=https://alpha.nbmrjun.top

# 本地存储与运行模式
DATABASE_PATH=data/alpha-reset.sqlite
DRY_RUN=0
